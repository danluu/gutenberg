#!/usr/bin/env bash
set -euo pipefail

repo_root="${RTC_FUZZ_ANALYSIS_REPO_ROOT:-}"

for arg in "$@"; do
	case "$arg" in
		artifacts|./artifacts|artifacts/rtc-browser-fuzz|./artifacts/rtc-browser-fuzz|test/e2e/artifacts|./test/e2e/artifacts)
			echo "rtc analysis guard: refusing broad rg rooted at '$arg'" >&2
			exit 64
			;;
	esac

	if [ -n "$repo_root" ]; then
		case "$arg" in
			"$repo_root"/artifacts|"$repo_root"/artifacts/rtc-browser-fuzz|"$repo_root"/test/e2e/artifacts)
				echo "rtc analysis guard: refusing broad rg rooted at '$arg'" >&2
				exit 64
				;;
		esac
	fi
done

real_rg="${RTC_FUZZ_ANALYSIS_REAL_RG:-}"
if [ -z "$real_rg" ]; then
	for candidate in \
		/opt/homebrew/bin/rg \
		/usr/local/bin/rg \
		"$HOME/.nvm/versions/node/v20.19.0/lib/node_modules/@openai/codex/node_modules/@openai/codex-darwin-arm64/vendor/aarch64-apple-darwin/path/rg"
	do
		if [ -x "$candidate" ]; then
			real_rg="$candidate"
			break
		fi
	done
fi

if [ -z "$real_rg" ]; then
	echo "rtc analysis guard: could not locate real rg" >&2
	exit 127
fi

exec "$real_rg" "$@"
