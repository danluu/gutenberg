{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"classification",
		"confidence",
		"userHitLikelihoodScore",
		"userHitLikelihoodRationale",
		"summary",
		"evidence",
		"recommendedRunnerAction",
		"harnessChangesApplied",
		"changedFiles",
		"validationSummary"
	],
	"properties": {
		"classification": {
			"type": "string",
			"enum": [ "real", "not_real", "uncertain" ]
		},
		"confidence": {
			"type": "string",
			"enum": [ "low", "medium", "high" ]
		},
		"userHitLikelihoodScore": {
			"type": "integer",
			"minimum": 0,
			"maximum": 5,
			"description": "How likely a normal user is to hit this issue: 0 = not user-visible/harness-only, 5 = very likely in common default workflows."
		},
		"userHitLikelihoodRationale": {
			"type": "string"
		},
		"summary": {
			"type": "string"
		},
		"evidence": {
			"type": "array",
			"items": {
				"type": "string"
			}
		},
		"recommendedRunnerAction": {
			"type": "string",
			"enum": [
				"keep-running",
				"continue-after-harness-change",
				"stop-for-manual-triage"
			]
		},
		"harnessChangesApplied": {
			"type": "boolean"
		},
		"changedFiles": {
			"type": "array",
			"items": {
				"type": "string"
			}
		},
		"validationSummary": {
			"type": "string"
		}
	}
}
